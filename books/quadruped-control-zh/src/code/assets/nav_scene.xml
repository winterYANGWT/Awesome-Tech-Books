<mujoco model="a1 nav scene">
  <include file="menagerie/unitree_a1/a1.xml"/>
  <compiler angle="radian" meshdir="menagerie/unitree_a1/assets" texturedir="menagerie/unitree_a1/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="crate" rgba="0.55 0.35 0.18 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <camera name="nav_view" mode="targetbody" target="trunk"
            pos="2.2 -2.4 1.6" fovy="50"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Static obstacles used by the Chapter 11 navigation example.
         group=1 is the geometric group seen by Lidar2D's default mask;
         the robot's own geoms are in groups 2 and 3. -->
    <geom name="crate_mid" type="box" pos="1.35 0.0 0.35"
          size="0.30 0.45 0.35" material="crate" group="1"/>
    <geom name="crate_left" type="box" pos="2.25 0.95 0.25"
          size="0.25 0.30 0.25" material="crate" group="1"/>
    <geom name="crate_right" type="box" pos="2.25 -0.95 0.25"
          size="0.25 0.30 0.25" material="crate" group="1"/>
  </worldbody>
</mujoco>
