  "nodes": [
    {"id": "req", "label": "退款请求", "at": [0, 0]},
    {"id": "appr", "label": "批准单", "sub": "approvals", "at": [1, 0], "shape": "store"},
    {"id": "exec", "label": "执行退款", "sub": "issue_refund_approved", "at": [2, 0]},
    {"id": "actions", "label": "actions", "sub": "detail.approval_id", "at": [3, 0], "shape": "store"},
    {"id": "approvals", "label": "approvals", "sub": "decision / 审批人", "at": [2, 1], "shape": "store"},
    {"id": "audit", "label": "审计查询", "sub": "重复 / 超时 / 越级", "at": [3, 1], "shape": "round"}
