    {"id": "e4", "from": "exec", "to": "approvals", "label": "写", "route": "vh"},
    {"id": "e5", "from": "actions", "to": "audit", "label": "读", "route": "vh"},
    {"id": "e6", "from": "approvals", "to": "audit", "label": "读"}
