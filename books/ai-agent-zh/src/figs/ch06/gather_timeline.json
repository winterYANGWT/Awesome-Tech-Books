{
  "kind": "seq",
  "title": "三个检查并行：一个失败，另外两个还在",
  "alt": "三个请求同时发出，语气检查最先返回并在交结果前抛错，gather 等齐后仍保留政策与隐私的结论",
  "lanes": [
    {
      "id": "main",
      "label": "主程序"
    },
    {
      "id": "policy",
      "label": "政策检查"
    },
    {
      "id": "tone",
      "label": "语气检查"
    },
    {
      "id": "privacy",
      "label": "隐私检查"
    }
  ],
  "state": [
    {
      "id": "sent",
      "label": "已发出",
      "value": "0"
    },
    {
      "id": "back",
      "label": "已结束",
      "value": "0"
    },
    {
      "id": "sum",
      "label": "汇总",
      "value": "—"
    }
  ],
  "steps": [
    {
      "from": "main",
      "to": "policy",
      "text": "请求",
      "tone": "hot",
      "set": {
        "sent": "1"
      },
      "note": "主程序发出政策检查，不等待结果"
    },
    {
      "from": "main",
      "to": "tone",
      "text": "请求",
      "set": {
        "sent": "2"
      },
      "note": "紧接着发出语气检查"
    },
    {
      "from": "main",
      "to": "privacy",
      "text": "请求",
      "set": {
        "sent": "3"
      },
      "note": "再发隐私检查：三个请求同时在跑"
    },
    {
      "from": "tone",
      "to": "main",
      "text": "ValueError 0.7s",
      "tone": "bad",
      "set": {
        "back": "1"
      },
      "note": "语气检查最先拿到回复，随后在结果返回前抛错"
    },
    {
      "from": "privacy",
      "to": "main",
      "text": "结果 0.8s",
      "tone": "ok",
      "set": {
        "back": "2"
      },
      "note": "隐私检查返回，gather 还在等政策"
    },
    {
      "from": "policy",
      "to": "main",
      "text": "结果 1.1s",
      "tone": "ok",
      "set": {
        "back": "3"
      },
      "note": "政策检查最后返回，三个任务都结束了"
    },
    {
      "at": "main",
      "text": "gather 等齐",
      "tone": "wait",
      "set": {
        "sum": "等齐 3 个"
      },
      "note": "return_exceptions=True，等全部结束"
    },
    {
      "at": "main",
      "text": "按输入顺序汇总",
      "tone": "hot",
      "set": {
        "sum": "政策 ok、语气失败"
      },
      "note": "固定顺序打印；缺一项就走人工"
    }
  ]
}
