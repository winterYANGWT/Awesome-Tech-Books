{
  "kind": "grid",
  "title": "渐进式披露：目录、一节、整份文档",
  "alt": "目录点亮全部 15 节，读一节只多点亮一节，整份文档才全部点亮",
  "rows": [
    {"label": "目录（15 节）"},
    {"label": "读到的一节"},
    {"label": "整份文档"}
  ],
  "cols": 15,
  "colLabels": "index",
  "legend": [
    {"key": "cat", "label": "目录条目"},
    {"key": "sec", "label": "一节正文"},
    {"key": "doc", "label": "整份文档"}
  ],
  "brackets": [
    {"c": "5-9", "label": "returns 的 5 节"}
  ],
  "steps": [
    {"paint": [{"r": 0, "c": "*", "key": "cat"}],
     "note": "先只放目录：15 个标题和字数，约 300 token"},
    {"mark": [{"r": 0, "c": 5}],
     "note": "问题落在退货期限：目录指向第 6 节"},
    {"paint": [{"r": 1, "c": 5, "key": "sec"}], "mark": [{"r": 1, "c": 5}],
     "note": "只读这一节：95 字，约 130 token"},
    {"mark": [{"r": 1, "c": 5}],
     "note": "目录还在上下文里，正文只多了一节"},
    {"paint": [{"r": 2, "c": "*", "key": "doc"}],
     "note": "只有需要时才加载整份文档正文：1275 字"}
  ]
}
