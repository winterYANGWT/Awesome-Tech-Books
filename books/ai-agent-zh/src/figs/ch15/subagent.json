{
  "kind": "seq",
  "title": "子 agent：两条上下文，只交回一段摘要",
  "alt": "子 agent 在自己的窗口里连查订单和评论，主 agent 只收到摘要和 gaps",
  "lanes": [
    {"id": "main", "label": "主 agent", "role": "process"},
    {"id": "sub", "label": "子 agent", "role": "process"},
    {"id": "tool", "label": "工具", "role": "memory"}
  ],
  "state": [
    {"id": "main_n", "label": "主上下文", "value": "2 条"},
    {"id": "sub_n", "label": "子上下文", "value": "0 条"}
  ],
  "steps": [
    {"from": "main", "to": "sub", "text": "任务：查 C082 缺页", "set": {"sub_n": "2 条"}, "note": "主 agent 给目标、输出格式和边界"},
    {"from": "sub", "to": "tool", "text": "customer_orders(C082)", "note": "子 agent 先拿 6 张订单的索引"},
    {"from": "tool", "to": "sub", "text": "6 张订单", "set": {"sub_n": "4 条"}, "note": "订单索引进入子 agent 的窗口"},
    {"from": "sub", "to": "tool", "text": "get_order ×3", "note": "只查时间窗内的 3 张明细"},
    {"from": "tool", "to": "sub", "text": "3 张明细", "set": {"sub_n": "8 条"}, "note": "原始 JSON 留在子 agent 窗口里"},
    {"from": "sub", "to": "tool", "text": "list_reviews ×2", "note": "评论只读到 2 本，证据不全"},
    {"from": "sub", "to": "main", "text": "摘要 + gaps", "tone": "ok", "set": {"main_n": "3 条"}, "note": "主 agent 只收到摘要，看不到原始工具结果"},
    {"at": "main", "text": "答：不能确认，列 gaps", "tone": "wait", "note": "摘要缺评论证据，主 agent 如实说不能确认"}
  ]
}
