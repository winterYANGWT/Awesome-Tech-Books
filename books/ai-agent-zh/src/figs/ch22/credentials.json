{
  "kind": "flow",
  "title": "凭据留在沙箱外：代理拿 token，沙箱只拿结果",
  "alt": "harness 让沙箱执行代码，同时通过代理和 vault 调外部服务；沙箱与 vault 之间没有通路",
  "static": true,
  "grid": [3, 2],
  "nodes": [
    {"id": "h", "label": "harness", "at": [0, 0], "shape": "round", "sub": "不知道 token"},
    {"id": "box", "label": "sandbox", "at": [0, 1], "shape": "round", "sub": "env 空"},
    {"id": "proxy", "label": "MCP 代理", "at": [1, 0], "shape": "box", "sub": "按 session 取"},
    {"id": "vault", "label": "vault", "at": [1, 1], "shape": "store", "sub": "token 只在这"},
    {"id": "svc", "label": "外部服务", "at": [2, 0], "shape": "box", "sub": "校验 bearer"}
  ],
  "edges": [
    {"id": "exec", "from": "h", "to": "box", "label": "execute"},
    {"id": "tool", "from": "h", "to": "proxy", "label": "tool call"},
    {"id": "token", "from": "proxy", "to": "vault", "label": "取 token"},
    {"id": "call", "from": "proxy", "to": "svc", "label": "带 token"},
    {"id": "back", "from": "svc", "to": "proxy", "label": "结果"},
    {"id": "str", "from": "proxy", "to": "h", "label": "字符串"}
  ],
  "steps": [
    {"note": "沙箱能执行代码，也能让代理替它调用；但 token 只在 vault 和代理进程里。", "hi": ["proxy", "vault"]}
  ]
}
