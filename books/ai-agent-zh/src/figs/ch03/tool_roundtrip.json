{
  "kind": "seq",
  "title": "一次工具调用：从提问到带答案的回复",
  "alt": "模型只返回 get_order 调用；客户端执行、回填 role:tool 后，模型才写出答案",
  "lanes": [
    {"id": "user", "label": "用户"},
    {"id": "client", "label": "客户端", "role": "process"},
    {"id": "model", "label": "模型", "role": "device"},
    {"id": "data", "label": "书店数据", "role": "memory"}
  ],
  "state": [
    {"id": "msgs", "label": "对话消息", "value": "2"},
    {"id": "last", "label": "最近一条", "value": "user"}
  ],
  "steps": [
    {"from": "user", "to": "client", "text": "A1670 到哪了", "note": "顾客只发了一句话"},
    {"from": "client", "to": "model", "text": "对话 + get_order 定义", "set": {"msgs": "2"}, "note": "客户端把历史和工具 schema 一起发出"},
    {"from": "model", "to": "client", "text": "tool_calls：get_order", "tone": "hot", "set": {"msgs": "3", "last": "assistant"}, "note": "模型没有回答，只要求调用 get_order"},
    {"from": "client", "to": "data", "text": "get_order(A1670)", "note": "客户端替模型执行工具"},
    {"from": "data", "to": "client", "text": "迅达快递，运输中", "note": "工具返回 JSON 文本"},
    {"from": "client", "to": "model", "text": "role:tool + 结果", "set": {"msgs": "4", "last": "tool"}, "note": "assistant 的 tool_calls 和 tool 结果都放回对话"},
    {"from": "model", "to": "client", "text": "答复：运输中，1～3 天", "tone": "ok", "set": {"msgs": "5", "last": "assistant"}, "note": "模型看到结果后才写答案"},
    {"from": "client", "to": "user", "text": "转达给顾客", "tone": "ok", "note": "客户端把答案交给顾客"}
  ]
}
