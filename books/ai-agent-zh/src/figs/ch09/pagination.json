    {"id": "cursor", "label": "next_cursor", "sub": "还有 4 条", "at": [2, 0]},
    {"id": "page2", "label": "第 2 页", "sub": "3 条 + 新游标", "at": [2, 1]},
    {"id": "merge", "label": "合并各页", "sub": "含第 3 页", "at": [1, 1]},
    {"id": "answer", "label": "回答", "sub": "3 本，完整", "at": [0, 1]}
  ],
  "edges": [
    {"id": "e1", "from": "query", "to": "page1", "label": "每页 3 条"},
