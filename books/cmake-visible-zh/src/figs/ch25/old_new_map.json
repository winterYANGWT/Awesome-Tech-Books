    {"id": "topt", "label": "目标选项", "sub": "`target_compile_options`", "at": [2, 1]},
    {"id": "vars", "label": "变量", "sub": "`${X_LIBRARIES}`", "at": [0, 2]},
    {"id": "target", "label": "导入目标", "sub": "`X::X`", "at": [2, 2]},
    {"id": "macro", "label": "宏", "sub": "在调用者作用域展开", "at": [0, 3]},
    {"id": "func", "label": "函数", "sub": "自己的变量作用域", "at": [2, 3]}
