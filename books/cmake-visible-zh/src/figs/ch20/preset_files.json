{
  "kind": "flow",
  "title": "三个预设文件谁包含谁",
  "alt": "用户文件自动包含项目文件，项目文件再用 include 引入共享文件",
  "static": true,
  "grid": [1, 3],
  "nodes": [
    {
      "id": "user",
      "label": "用户预设文件",
      "sub": "CMakeUserPresets.json\n不提交",
      "at": [0, 0]
    },
    {
      "id": "proj",
      "label": "项目预设文件",
      "sub": "CMakePresets.json\n提交",
      "at": [0, 1]
    },
    {
      "id": "shared",
      "label": "共享预设文件",
      "sub": "presets/ci.json\n被 include",
      "at": [0, 2]
    }
  ],
  "edges": [
    {"id": "implicit", "from": "user", "to": "proj", "label": "隐式包含", "dashed": true},
    {"id": "include", "from": "proj", "to": "shared", "label": "include"}
  ],
  "steps": [
    {
      "hi": ["user", "proj", "shared"],
      "note": "用户文件可以继承项目里的预设，项目文件不能继承用户文件里的预设"
    }
  ]
}
