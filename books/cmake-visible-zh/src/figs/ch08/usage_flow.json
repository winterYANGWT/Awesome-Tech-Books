{
  "kind": "flow",
  "title": "用法要求沿链接关系走",
  "alt": "core 的 INTERFACE_* 经 net 到 app；PRIVATE 的宏在 core 边界停下",
  "grid": [
    3,
    1
  ],
  "nodes": [
    {
      "id": "core",
