{
  "title": "Config 文件和版本文件",
  "runs": [
    {
      "label": "配置、安装",
      "after": [
        ["./build/app"],
        ["cmake", "--install", "build", "--prefix", "prefix"],
        ["grep", "-n", "get_filename_component(PACKAGE_PREFIX_DIR", "prefix/lib/cmake/Greet/GreetConfig.cmake"],
        ["grep", "-n", "include(.*GreetTargets", "prefix/lib/cmake/Greet/GreetConfig.cmake"],
        ["grep", "-n", "set(PACKAGE_VERSION", "prefix/lib/cmake/Greet/GreetConfigVersion.cmake"]
      ]
    }
  ],
  "expect": [
    "^hello, consumer!$",
    "get_filename_component\\(PACKAGE_PREFIX_DIR.*CMAKE_CURRENT_LIST_DIR",
    "include\\(\".*GreetTargets.cmake\"\\)",
    "set\\(PACKAGE_VERSION \"1.2.0\"\\)"
  ],
  "expect_not": ["CMake Error"]
}
