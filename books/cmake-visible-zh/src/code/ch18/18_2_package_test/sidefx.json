{
  "title": "把消费测试放进 CTest",
  "runs": [
    {
      "label": "配置、构建、ctest",
      "after": [
        ["ctest", "--test-dir", "build", "-j", "4", "--output-on-failure"],
        ["ctest", "--test-dir", "build", "-V"]
      ]
    }
  ],
  "expect": [
    "1/3 Test #1: package_install",
    "2/3 Test #2: package_consumer",
    "3/3 Test #3: package_consumer_build",
    "3: hello, installed package!",
    "100% tests passed, 0 tests failed out of 3"
  ],
  "expect_not": ["CMake Error", "CMake Warning"]
}
