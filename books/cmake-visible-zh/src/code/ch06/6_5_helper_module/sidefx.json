{
  "title": "辅助模块的模板和返回值",
  "runs": [
    {
      "label": "配置、构建、运行",
      "after": [
        [
          "./build/app"
        ]
      ]
    }
  ],
  "expect": [
    "模板目录=/work/src/cmake",
