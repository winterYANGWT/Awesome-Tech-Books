$ kubectl -n shorty get deploy api
NAME   READY   UP-TO-DATE   AVAILABLE   AGE
api    2/2     2            2           106s
$ kubectl -n shorty get pods -l app.kubernetes.io/name=api -o wide
NAME                   READY   STATUS    RESTARTS   AGE    IP            NODE                   NOMINATED NODE   READINESS GATES
api-547fc786f9-fz44m   1/1     Running   0          106s   10.244.0.14   shorty-control-plane   <none>           <none>
api-547fc786f9-mrrws   1/1     Running   0          106s   10.244.0.15   shorty-control-plane   <none>           <none>
$ kubectl -n shorty port-forward svc/shorty-gw-nginx 18081:80 >/tmp/ch35-pf-gw.log 2>&1 &
$ PFG=$!
$ curl --retry 30 --retry-delay 1 --retry-all-errors -sS -o /dev/null 2>/dev/null \
  -w 'gateway /healthz -> %{http_code}\n' localhost:18081/healthz
gateway /healthz -> 200
$ POD=$(kubectl -n shorty get pod -l app.kubernetes.io/name=api \
  -o jsonpath='{.items[0].metadata.name}')
$ kubectl -n shorty port-forward pod/$POD 18082:8080 >/tmp/ch35-pf-api.log 2>&1 &
$ PF=$!
$ curl --retry 30 --retry-delay 1 --retry-all-errors -sS 2>/dev/null -X POST \
  'localhost:18082/admin/fault?not_ready=true'
{"latency_ms":0,"error_rate":0,"leak_mb":0,"not_ready":true,"crash_after":0,"ignore_sigterm":false}
$ kubectl -n shorty wait --for=condition=Ready=false pod/$POD --timeout=90s
pod/api-547fc786f9-fz44m condition met
$ kubectl -n shorty get events --field-selector reason=Unhealthy --sort-by=.lastTimestamp
LAST SEEN   TYPE      REASON      OBJECT                     MESSAGE
115s        Warning   Unhealthy   pod/api-547fc786f9-fz44m   Readiness probe failed: Get "http://10.244.0.14:8080/readyz": context deadline exceeded (Client.Timeout exceeded while awaiting headers)
115s        Warning   Unhealthy   pod/api-547fc786f9-mrrws   Readiness probe failed: Get "http://10.244.0.15:8080/readyz": context deadline exceeded (Client.Timeout exceeded while awaiting headers)
115s        Warning   Unhealthy   pod/api-547fc786f9-mrrws   Readiness probe failed: HTTP probe failed with statuscode: 503
0s          Warning   Unhealthy   pod/api-547fc786f9-fz44m   Readiness probe failed: HTTP probe failed with statuscode: 503
$ kubectl -n shorty get deploy api
NAME   READY   UP-TO-DATE   AVAILABLE   AGE
api    1/2     2            1           119s
$ kubectl -n shorty get pods -l app.kubernetes.io/name=api
NAME                   READY   STATUS    RESTARTS   AGE
api-547fc786f9-fz44m   0/1     Running   0          119s
api-547fc786f9-mrrws   1/1     Running   0          119s
$ kubectl -n shorty describe pod $POD \
  | grep -E '^[[:space:]]+(State|Ready|Restart Count):|^Conditions:|^[[:space:]]+(Initialized|Ready|ContainersReady|PodScheduled)[[:space:]]'
    State:          Running
    Ready:          False
    Restart Count:  0
Conditions:
  Initialized                 True
  Ready                       False
  ContainersReady             False
  PodScheduled                True
$ kubectl -n shorty logs $POD --tail=100 \
  | jq -c 'select(.path == "/readyz") | {status, path, duration_ms}' | tail -n 3
{"status":503,"path":"/readyz","duration_ms":0.33}
{"status":503,"path":"/readyz","duration_ms":0.299}
{"status":503,"path":"/readyz","duration_ms":0.092}
$ kubectl -n shorty get endpointslice -l kubernetes.io/service-name=api \
  -o jsonpath='{range .items[*].endpoints[*]}{.addresses[0]}{" ready="}{.conditions.ready}{"\n"}{end}'
10.244.0.14 ready=false
10.244.0.15 ready=true
$ curl -sS localhost:18082/readyz
not ready: fault: not_ready
$ curl -sS -o /dev/null -w 'gateway /healthz -> %{http_code}\n' localhost:18081/healthz
gateway /healthz -> 200
$ curl -sS -X POST 'localhost:18082/admin/fault?not_ready=false'
{"latency_ms":0,"error_rate":0,"leak_mb":0,"not_ready":false,"crash_after":0,"ignore_sigterm":false}
$ kubectl -n shorty wait --for=condition=Ready pod/$POD --timeout=90s
pod/api-547fc786f9-fz44m condition met
$ kubectl -n shorty wait --for=jsonpath='{.status.availableReplicas}'=2 \
  deployment/api --timeout=90s
deployment.apps/api condition met
$ kubectl -n shorty get deploy api
NAME   READY   UP-TO-DATE   AVAILABLE   AGE
api    2/2     2            2           2m4s
$ kill $PF $PFG
