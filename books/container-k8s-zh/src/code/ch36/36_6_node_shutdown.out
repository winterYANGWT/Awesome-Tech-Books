$ docker stop "$TARGET"
shorty-worker2
$ for i in $(seq 1 60); do
  STATE=$(kubectl get node "$TARGET" \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
  if [ "$STATE" != True ]; then break; fi
  sleep 2
done
$ echo "Ready condition: $STATE"
Ready condition: Unknown
