$ for i in $(seq 1 60); do
  LEFT=$(kubectl -n shorty get pods --field-selector "spec.nodeName=$TARGET" \
    --no-headers 2>/dev/null | wc -l)
  if [ "$LEFT" -eq 0 ]; then break; fi
  sleep 2
done
