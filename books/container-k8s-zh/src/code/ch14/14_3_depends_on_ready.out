$ code=000
$ for i in $(seq 1 40); do
  code=$(curl -s -o /tmp/ch14-ready -w '%{http_code}' localhost:8080/readyz || true)
  [ "$code" = 503 ] && break
  sleep 0.5
done
$ echo "status=$code"
status=503
$ cat /tmp/ch14-ready
not ready: database: failed to connect to `user=shorty database=shorty`: 172.19.0.2:5432 (postgres): dial error: dial tcp 172.19.0.2:5432: connect: connection refused
$ code=000
$ for i in $(seq 1 30); do
  code=$(curl -s -o /tmp/ch14-ready -w '%{http_code}' localhost:8080/readyz || true)
  [ "$code" = 200 ] && break
  sleep 1
done
$ echo "status=$code"
status=200
$ cat /tmp/ch14-ready
ok
