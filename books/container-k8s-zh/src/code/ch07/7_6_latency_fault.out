$ curl -fsS -X POST 'localhost:8080/admin/fault?error_rate=1' > /dev/null
$ for _ in 1 2 3; do
    curl -sS -o /dev/null -w '%{http_code}\n' http://localhost:8080/healthz
done
500
500
