NAME                   READY   STATUS    RESTARTS   AGE
api-558869f4d9-kx4fj   1/1     Running   0          3s
$ kubectl -n shorty set env deployment/api SHORTY_FAULT_NOT_READY=1
deployment.apps/api env updated
