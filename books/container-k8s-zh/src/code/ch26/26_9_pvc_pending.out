$ kubectl apply -f pending-pvcs.yaml
namespace/trouble-demo created
persistentvolumeclaim/missing-class created
persistentvolumeclaim/no-class created
persistentvolumeclaim/waiting created
$ kubectl -n trouble-demo get pvc -o custom-columns=NAME:.metadata.name,STATUS:.status.phase,VOLUME:.spec.volumeName,CLASS:.spec.storageClassName
NAME            STATUS    VOLUME   CLASS
missing-class   Pending   <none>   does-not-exist
no-class        Pending   <none>
waiting         Pending   <none>   standard
$ kubectl -n trouble-demo describe pvc missing-class | sed -n '/^Events:/,$p'
Events:
  Type     Reason              Age   From                         Message
  ----     ------              ----  ----                         -------
  Warning  ProvisioningFailed  0s    persistentvolume-controller  storageclass.storage.k8s.io "does-not-exist" not found
$ kubectl -n trouble-demo describe pvc no-class | sed -n '/^Events:/,$p'
Events:
  Type    Reason         Age   From                         Message
  ----    ------         ----  ----                         -------
  Normal  FailedBinding  0s    persistentvolume-controller  no persistent volumes available for this claim and no storage class is set
$ kubectl -n trouble-demo describe pvc waiting | sed -n '/^Events:/,$p'
Events:
  Type    Reason                Age   From                         Message
  ----    ------                ----  ----                         -------
  Normal  WaitForFirstConsumer  0s    persistentvolume-controller  waiting for first consumer to be created before binding
