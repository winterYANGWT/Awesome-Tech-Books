$ NODE=$(kind get nodes --name shorty)
$ docker exec "$NODE" crictl --runtime-endpoint unix:///run/containerd/containerd.sock.bak ps
time="2026-10-27T15:19:50Z" level=fatal msg="validate service connection: validate CRI v1 runtime API for endpoint \"unix:///run/containerd/containerd.sock.bak\": rpc error: code = Unavailable desc = connection error: desc = \"transport: Error while dialing: dial unix /run/containerd/containerd.sock.bak: connect: no such file or directory\""
$ docker exec "$NODE" crictl --runtime-endpoint unix:///dev/null ps
time="2026-10-27T15:19:50Z" level=fatal msg="validate service connection: validate CRI v1 runtime API for endpoint \"unix:///dev/null\": rpc error: code = Unavailable desc = connection error: desc = \"transport: Error while dialing: dial unix /dev/null: connect: connection refused\""
$ docker exec "$NODE" crictl --runtime-endpoint unix:///run/containerd/containerd.sock ps | sed -n "1,4p"
CONTAINER           IMAGE               CREATED              STATE               NAME                      ATTEMPT             POD ID              POD                                            NAMESPACE
2a242b4ba7a50       3b39acc1c2e43       About a minute ago   Running             app                       0                   fc4dc319eb1a1       shorty-66886646dc-7gsbh                        shorty
c88125cefe10a       c82008e2cd018       About a minute ago   Running             local-path-provisioner    0                   e2966d27c1d86       local-path-provisioner-75f7fc7dc5-9nbbb        local-path-storage
c9c2077d28147       520212b8b0fcd       About a minute ago   Running             coredns                   0                   8fa5b4c6f7b58       coredns-559f6c778d-gq2t7                       kube-system
$ docker exec "$NODE" crictl info | jq '{defaultRuntime: .config.containerd.defaultRuntimeName,
  handlers: (.config.containerd.runtimes | keys),
  runcType: .config.containerd.runtimes.runc.runtimeType}'
{
  "defaultRuntime": "runc",
  "handlers": [
    "runc",
    "test-handler"
  ],
  "runcType": "io.containerd.runc.v2"
}
$ pod_id=$(docker exec "$NODE" crictl pods --namespace shorty -q)
$ cid=$(docker exec "$NODE" crictl ps --pod "$pod_id" -q)
$ docker exec "$NODE" crictl inspect "$cid" \
  | jq '{state: .status.state, exitCode: .status.exitCode}'
{
  "state": "CONTAINER_RUNNING",
  "exitCode": 0
}
$ docker exec "$NODE" crictl stats "$cid"
CONTAINER           NAME                CPU %               MEM                 DISK                INODES              SWAP
2a242b4ba7a50       app                 0.01                2.347MB             40.96kB             12                  0B
