$ kubectl apply -f sts-pending.yaml
statefulset.apps/postgres-bad created
$ kubectl -n sts-demo wait --for=jsonpath='{.status.phase}'=Pending pod/postgres-bad-0 --timeout=60s
pod/postgres-bad-0 condition met
$ kubectl -n sts-demo get pod postgres-bad-0
NAME             READY   STATUS    RESTARTS   AGE
postgres-bad-0   0/1     Pending   0          0s
$ kubectl -n sts-demo get pvc data-postgres-bad-0
NAME                  STATUS    VOLUME   CAPACITY   ACCESS MODES   STORAGECLASS     VOLUMEATTRIBUTESCLASS   AGE
data-postgres-bad-0   Pending                                      does-not-exist   <unset>                 0s
$ kubectl -n sts-demo describe pvc data-postgres-bad-0 | tail -n 8
Capacity:
Access Modes:
VolumeMode:    Filesystem
Used By:       postgres-bad-0
Events:
  Type     Reason              Age   From                         Message
  ----     ------              ----  ----                         -------
  Warning  ProvisioningFailed  0s    persistentvolume-controller  storageclass.storage.k8s.io "does-not-exist" not found
$ kubectl -n sts-demo describe pod postgres-bad-0 | tail -n 10
    Optional:                false
    DownwardAPI:             true
QoS Class:                   BestEffort
Node-Selectors:              <none>
Tolerations:                 node.kubernetes.io/not-ready:NoExecute op=Exists for 300s
                             node.kubernetes.io/unreachable:NoExecute op=Exists for 300s
Events:
  Type     Reason            Age   From               Message
  ----     ------            ----  ----               -------
  Warning  FailedScheduling  0s    default-scheduler  0/1 nodes are available: pod has unbound immediate PersistentVolumeClaims. not found
$ kubectl -n sts-demo delete statefulset postgres-bad --wait=true
statefulset.apps "postgres-bad" deleted from sts-demo namespace
$ kubectl -n sts-demo delete pvc data-postgres-bad-0 --wait=true
persistentvolumeclaim "data-postgres-bad-0" deleted from sts-demo namespace
$ kubectl delete namespace sts-demo --wait=true
namespace "sts-demo" deleted
