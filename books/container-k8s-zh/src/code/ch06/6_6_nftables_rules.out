$ docker info --format 'firewall_backend={{.FirewallBackend.Driver}}'
firewall_backend=iptables
$ nft list tables
table ip nat
table ip filter
table ip6 nat
table ip6 filter
table ip raw
$ nft list chain ip nat DOCKER
# Warning: table ip nat is managed by iptables-nft, do not touch!
table ip nat {
	chain DOCKER {
		ip daddr 127.0.0.1 iifname != "br-67feaf88c60b" tcp dport 8080 counter packets 0 bytes 0 xt target "DNAT"
	}
}
$ nft list chain ip nat POSTROUTING
# Warning: table ip nat is managed by iptables-nft, do not touch!
table ip nat {
	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 172.19.0.0/16 oifname != "br-67feaf88c60b" counter packets 0 bytes 0 xt target "MASQUERADE"
		ip saddr 172.18.0.0/16 oifname != "docker0" counter packets 6 bytes 396 xt target "MASQUERADE"
	}
}
$ nft list ruleset | grep -E '^(table|[[:space:]]+chain)|xt target' | sed -n '1,24p'
# Warning: table ip nat is managed by iptables-nft, do not touch!
# Warning: table ip filter is managed by iptables-nft, do not touch!
table ip nat {
# Warning: table ip6 nat is managed by iptables-nft, do not touch!
	chain DOCKER {
		ip daddr 127.0.0.1 iifname != "br-67feaf88c60b" tcp dport 8080 counter packets 0 bytes 0 xt target "DNAT"
	chain PREROUTING {
	chain OUTPUT {
	chain POSTROUTING {
		ip saddr 172.19.0.0/16 oifname != "br-67feaf88c60b" counter packets 0 bytes 0 xt target "MASQUERADE"
		ip saddr 172.18.0.0/16 oifname != "docker0" counter packets 6 bytes 396 xt target "MASQUERADE"
table ip filter {
	chain DOCKER {
	chain DOCKER-FORWARD {
	chain DOCKER-BRIDGE {
	chain DOCKER-CT {
	chain DOCKER-INTERNAL {
	chain FORWARD {
	chain DOCKER-USER {
table ip6 nat {
	chain DOCKER {
	chain PREROUTING {
	chain OUTPUT {
table ip6 filter {
	chain DOCKER {
	chain DOCKER-FORWARD {
	chain DOCKER-BRIDGE {
$ nft list chain ip filter DOCKER-USER
table ip filter {
	chain DOCKER-USER {
	}
}
$ iptables-save | sed -n '1p'
# Generated by iptables-save v1.8.13 (nf_tables) on Wed Oct 28 11:09:16 2026
$ iptables-save -t nat | grep -E 'DNAT|MASQUERADE' | sed -n '1,5p'
-A POSTROUTING -s 172.19.0.0/16 ! -o br-67feaf88c60b -j MASQUERADE
-A POSTROUTING -s 172.18.0.0/16 ! -o docker0 -j MASQUERADE
-A DOCKER -d 127.0.0.1/32 ! -i br-67feaf88c60b -p tcp -m tcp --dport 8080 -j DNAT --to-destination 172.19.0.4:8080
