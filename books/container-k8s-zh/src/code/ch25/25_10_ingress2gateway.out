$ ingress2gateway print --providers=ingress-nginx -n shorty -o yaml > ingress2gateway.yaml
┌─ WARN  ────────────────────────────────────────
│  Unsupported annotation nginx.ingress.kubernetes.io/limit-rps
│  source: INGRESS-NGINX
│  object: : shorty/shorty
└─
┌─ WARN  ────────────────────────────────────────
│  Failed to apply shorty.shorty.metadata.annotations."nginx.ingress.kubernetes.io/proxy-body-size" from shorty/shorty: Most Gateway API implementations have reasonable body size and buffering defaults
│  source: STANDARD_EMITTER
│  object: HTTPRoute: shorty/shorty-shorty-local
└─
┌─ WARN  ────────────────────────────────────────
│  Failed to apply shorty.shorty.metadata.annotations."nginx.ingress.kubernetes.io/proxy-body-size" from shorty/shorty: Most Gateway API implementations have reasonable body size and buffering defaults
│  source: STANDARD_EMITTER
│  object: HTTPRoute: shorty/shorty-shorty-local
└─
┌─ WARN  ────────────────────────────────────────
│  Gateway API does not support configuring URL normalization (RFC 3986, Section 6). Please check if this matters for your use case and consult implementation-specific details.
│  source: STANDARD_EMITTER
└─
$ head -80 ingress2gateway.yaml
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  annotations:
    gateway.networking.k8s.io/generator: ingress2gateway-1.2.0
  name: nginx
  namespace: shorty
spec:
  gatewayClassName: nginx
  listeners:
  - hostname: shorty.local
    name: shorty-local-http
    port: 80
    protocol: HTTP
  - hostname: shorty.local
    name: shorty-local-https
    port: 443
    protocol: HTTPS
    tls:
      certificateRefs:
      - group: ""
        kind: Secret
        name: shorty-tls
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    gateway.networking.k8s.io/generator: ingress2gateway-1.2.0
  name: shorty-shorty-local
  namespace: shorty
spec:
  hostnames:
  - shorty.local
  parentRefs:
  - name: nginx
    port: 443
    sectionName: shorty-local-https
  rules:
  - backendRefs:
    - name: api
      port: 8080
    matches:
    - path:
        type: PathPrefix
        value: /api
  - backendRefs:
    - name: web
      port: 80
    matches:
    - path:
        type: PathPrefix
        value: /
status:
  parents: []
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    gateway.networking.k8s.io/generator: ingress2gateway-1.2.0
  name: shorty-shorty-local-http
  namespace: shorty
spec:
  hostnames:
  - shorty.local
  parentRefs:
  - name: nginx
    port: 80
  rules:
  - filters:
    - requestRedirect:
        scheme: https
        statusCode: 308
      type: RequestRedirect
    matches:
    - path:
        type: PathPrefix
        value: /api
  - filters:
$ sed -e 's/^  name: nginx$/  name: shorty-gw/' \
    -e 's/^  - name: nginx$/  - name: shorty-gw/' \
    -e 's/^  name: shorty-shorty-local$/  name: shorty/' \
    -e 's/^  name: shorty-shorty-local-http$/  name: shorty-http-redirect/' \
    ingress2gateway.yaml > ingress2gateway-fixed.yaml
$ kubectl diff -f ingress2gateway-fixed.yaml > /tmp/ch25-diff.txt 2>&1; rc=$?
$ head -60 /tmp/ch25-diff.txt
