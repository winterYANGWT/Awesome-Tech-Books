$ source ./rootless_env.bash
$ trap rootless_stop EXIT
$ rootless_start
$ DOCKER_HOST="unix://$RLS_SOCK" docker info 2> /dev/null | sed -n \
    -e '/^ Server Version:/p' -e '/^ Storage Driver:/p' -e '/^ Cgroup Driver:/p' \
    -e '/Security Options:/,+4p'
 Server Version: 29.9.2
 Storage Driver: overlayfs
 Cgroup Driver: none
 Security Options:
  seccomp
   Profile: builtin
  rootless
  cgroupns
$ ps -eo user=,pid=,comm=,args= | grep -E '[r]ootlesskit|[d]ockerd --rootless' | cut -c1-110
rls       196768 rootlesskit     rootlesskit --state-dir=/run/docker/rootlesskit --net=slirp4netns --mtu=65520
rls       196824 exe             /proc/self/exe --state-dir=/run/docker/rootlesskit --net=slirp4netns --mtu=65
rls       196853 dockerd         dockerd --rootless --iptables=false --ip6tables=false --data-root=/tmp/ch08-r
