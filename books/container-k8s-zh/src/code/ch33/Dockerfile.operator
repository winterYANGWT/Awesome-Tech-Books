# shorty-operator 的镜像：Python 标准库 + 官方 Kubernetes Python 客户端。
FROM python:3.15.2-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir kubernetes==37.0.1
WORKDIR /app
COPY shorty_operator.py /app/shorty_operator.py
USER 65532:65532
ENTRYPOINT ["python3", "/app/shorty_operator.py"]
