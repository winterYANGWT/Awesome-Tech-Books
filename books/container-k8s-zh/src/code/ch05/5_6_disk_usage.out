$ docker info --format 'Storage Driver={{.Driver}} Docker Root Dir={{.DockerRootDir}}'
Storage Driver=overlayfs Docker Root Dir=/var/lib/docker
$ docker system df
TYPE            TOTAL     ACTIVE    SIZE      RECLAIMABLE
