$ kubectl get deployment api -n shorty
NAME   READY   UP-TO-DATE   AVAILABLE   AGE
api    4/4     4            4           4m27s
$ for i in $(seq 1 15); do
  [ "$(kubectl top pods -n shorty -l app.kubernetes.io/name=api --no-headers 2>/dev/null | wc -l)" -eq 4 ] && break
  sleep 2
done
