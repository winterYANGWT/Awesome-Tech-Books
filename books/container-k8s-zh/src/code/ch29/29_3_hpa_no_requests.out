$ for i in $(seq 1 24); do
  cond=$(kubectl -n shorty get hpa api -o jsonpath='{range .status.conditions[?(@.type=="ScalingActive")]}{.status}/{.reason}{end}')
  echo "ScalingActive=$cond"
  [ "$cond" = "True/ValidMetricFound" ] && break
  sleep 5
done
