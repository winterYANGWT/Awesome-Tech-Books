$ kubectl apply -f vpa-components.yaml
customresourcedefinition.apiextensions.k8s.io/verticalpodautoscalers.autoscaling.k8s.io created
customresourcedefinition.apiextensions.k8s.io/verticalpodautoscalercheckpoints.autoscaling.k8s.io created
serviceaccount/vpa-recommender created
clusterrole.rbac.authorization.k8s.io/system:vpa-recommender created
clusterrolebinding.rbac.authorization.k8s.io/system:vpa-recommender created
deployment.apps/vpa-recommender created
$ kubectl wait --for=condition=Established crd/verticalpodautoscalers.autoscaling.k8s.io --timeout=120s
customresourcedefinition.apiextensions.k8s.io/verticalpodautoscalers.autoscaling.k8s.io condition met
$ kubectl -n kube-system rollout status deployment/vpa-recommender --timeout=180s
Waiting for deployment "vpa-recommender" rollout to finish: 0 of 1 updated replicas are available...
deployment "vpa-recommender" successfully rolled out
$ kubectl apply -f vpa-api.yaml
verticalpodautoscaler.autoscaling.k8s.io/api-vpa created
$ kubectl -n shorty get vpa api-vpa
NAME      MODE   CPU   MEMORY   PROVIDED   AGE
api-vpa   Off                              0s
$ for i in $(seq 1 36); do
  cpu=$(kubectl -n shorty get vpa api-vpa -o jsonpath='{.status.recommendation.containerRecommendations[0].target.cpu}')
  echo "recommendation target.cpu=${cpu:-pending}"
  [ -n "$cpu" ] && break
  sleep 10
done
recommendation target.cpu=pending
recommendation target.cpu=pending
recommendation target.cpu=pending
recommendation target.cpu=pending
recommendation target.cpu=pending
recommendation target.cpu=pending
recommendation target.cpu=25m
$ kubectl -n shorty get vpa api-vpa
NAME      MODE   CPU   MEMORY   PROVIDED   AGE
api-vpa   Off    25m   250Mi    True       60s
$ kubectl -n shorty describe vpa api-vpa | sed -n '/Recommendation:/,$p'
  Recommendation:
    Container Recommendations:
      Container Name:  api
      Lower Bound:
        Cpu:     25m
        Memory:  250Mi
      Target:
        Cpu:     25m
        Memory:  250Mi
      Uncapped Target:
        Cpu:     25m
        Memory:  250Mi
      Upper Bound:
        Cpu:     500m
        Memory:  512Mi
Events:          <none>
$ kubectl -n shorty get deployment api -o jsonpath='{.spec.template.spec.containers[0].resources}{"\n"}'
{"limits":{"cpu":"500m","memory":"256Mi"},"requests":{"cpu":"45m","memory":"64Mi"}}
$ kubectl -n shorty get pods -l app.kubernetes.io/name=api
NAME                READY   STATUS    RESTARTS   AGE
api-f6c986d-44q85   1/1     Running   0          5m
api-f6c986d-t4ktj   1/1     Running   0          6m44s
