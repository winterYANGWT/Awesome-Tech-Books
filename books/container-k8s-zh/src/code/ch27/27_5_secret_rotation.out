$ POD=$(kubectl -n shorty get pods -l app.kubernetes.io/name=api --sort-by=.metadata.creationTimestamp -o name | tail -n 1)
$ kubectl -n shorty logs "$POD" --tail=-1 | grep -E 'shorty starting|数据库和 Redis 已就绪'
