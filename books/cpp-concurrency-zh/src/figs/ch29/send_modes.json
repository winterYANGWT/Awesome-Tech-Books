{
  "kind": "seq",
  "title": "标准、同步、缓冲发送的返回点",
  "alt": "标准发送复制到内部缓冲区后可返回，同步发送等到接收开始，缓冲发送用用户提供的空间排队",
  "lanes": [
    {
      "id": "s",
      "label": "发送者"
    },
    {
      "id": "b",
      "label": "缓冲区",
      "role": "memory"
    },
    {
      "id": "r",
      "label": "接收者"
    }
  ],
  "state": [
    {
      "id": "where",
      "label": "消息在哪",
      "value": "发送缓冲区"
    },
    {
      "id": "ret",
      "label": "Send 何时返回",
      "value": "—"
    }
  ],
  "steps": [
    {
      "at": "s",
      "text": "`MPI_Send`",
      "note": "标准模式开始，先看有没有内部缓冲空间"
    },
    {
      "from": "s",
      "to": "b",
      "text": "复制",
      "set": {
        "where": "MPI 内部缓冲区"
      },
      "note": "小消息可能被复制进 MPI 的内部缓冲区"
    },
    {
      "at": "s",
      "text": "Send 返回",
      "tone": "ok",
      "set": {
        "ret": "复制完就返回"
      },
      "note": "返回只说明发送缓冲区可以复用"
    },
    {
      "from": "b",
      "to": "r",
      "text": "投递",
      "set": {
        "where": "接收者"
      },
      "note": "消息随后被送到接收端"
    },
    {
      "at": "r",
      "text": "`MPI_Recv` 开始",
      "note": "接收操作这时才真正开始匹配"
    },
    {
      "span": [
        "s",
        "b",
        "r"
      ],
      "text": "返回点看实现和消息大小",
      "tone": "wait",
      "note": "标准发送的返回点取决于实现和消息大小"
    },
    {
      "at": "s",
      "text": "`MPI_Ssend`",
      "set": {
        "where": "发送缓冲区",
        "ret": "等接收开始"
      },
      "note": "同步发送等到匹配的接收已经开始才返回"
    },
    {
      "from": "s",
      "to": "b",
      "text": "`MPI_Bsend`",
      "set": {
        "where": "用户缓冲区",
        "ret": "复制中"
      },
      "note": "缓冲发送先复制到用户用 Buffer_attach 提供的空间"
    },
    {
      "at": "s",
      "text": "Send 返回",
      "tone": "ok",
      "set": {
        "ret": "复制完就返回"
      },
      "note": "缓冲发送是本地操作，不等接收端"
    }
  ]
}
