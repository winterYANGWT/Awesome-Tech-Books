{
  "kind": "seq",
  "title": "Probe 只看信封，Get_count 定长度",
  "alt": "消息带着未知长度的数组到达，rank 0 先 Probe 读信封，再 Get_count，分配空间后 Recv 取走",
  "lanes": [
    {"id": "w", "label": "rank 1"},
    {"id": "q", "label": "rank 0 的队列", "role": "memory"},
    {"id": "c", "label": "rank 0 代码"}
