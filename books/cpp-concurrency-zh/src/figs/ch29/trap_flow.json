{
  "kind": "flow",
  "title": "梯形积分：点对点线性汇总与 Reduce 树形汇总",
  "alt": "四个 rank 各算一块；点对点版把局部和送到 0 号，虚线是 Reduce 的两两合并",
  "static": true,
  "grid": [5, 4],
  "nodes": [
    {"id": "r0", "label": "rank 0", "sub": "区间 1/4", "at": [0, 0], "shape": "round"},
    {"id": "r1", "label": "rank 1", "sub": "区间 2/4", "at": [0, 1], "shape": "round"},
    {"id": "r2", "label": "rank 2", "sub": "区间 3/4", "at": [0, 2], "shape": "round"},
    {"id": "r3", "label": "rank 3", "sub": "区间 4/4", "at": [0, 3], "shape": "round"},
    {"id": "root", "label": "rank 0 汇总", "sub": "p−1 次 Recv", "at": [2, 1], "shape": "store"},
    {"id": "t1", "label": "0+2", "sub": "rank 0、2 合并", "at": [3, 0], "shape": "store"},
    {"id": "t2", "label": "1+3", "sub": "rank 1、3 合并", "at": [3, 2], "shape": "store"},
    {"id": "sum", "label": "总和", "sub": "rank 0 的总和", "at": [4, 1], "shape": "store"}
  ],
  "edges": [
    {"id": "s1", "from": "r1", "to": "root", "label": "Send", "fromSide": "right", "toSide": "left"},
    {"id": "s2", "from": "r2", "to": "root", "label": "Send", "fromSide": "right", "toSide": "left"},
    {"id": "s3", "from": "r3", "to": "root", "label": "Send", "fromSide": "right", "toSide": "left"},
    {"id": "a0", "from": "r0", "to": "t1", "dashed": true},
    {"id": "a2", "from": "r2", "to": "t1", "dashed": true, "route": "vh"},
    {"id": "a1", "from": "r1", "to": "t2", "dashed": true, "route": "vh"},
    {"id": "a3", "from": "r3", "to": "t2", "dashed": true},
    {"id": "t01", "from": "t1", "to": "sum", "label": "合并", "dashed": true},
    {"id": "t23", "from": "t2", "to": "sum", "label": "合并", "dashed": true}
  ],
  "steps": [
    {"hi": ["r0", "r1", "r2", "r3"], "note": "每个 rank 只算自己那段区间的局部和"},
    {"token": [{"edge": "s1"}, {"edge": "s2"}, {"edge": "s3"}], "note": "点对点版：非 0 号各发一次，0 号收 p−1 次"},
    {"token": [{"edge": "t01"}, {"edge": "t23"}], "note": "Reduce 版：0 与 2、1 与 3 先合并，再合并两个部分和"}
  ]
}
