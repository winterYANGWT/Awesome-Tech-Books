        {
          "from": "t1",
          "to": "mem",
          "text": "写 [1]"
        },
        {
          "from": "t2",
          "to": "mem",
          "text": "写 [2]"
        },
        {
          "from": "t3",
          "to": "mem",
          "text": "写 [3]"
        }
