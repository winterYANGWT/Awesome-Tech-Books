    {
      "id": "ny",
      "label": "y 记事本",
      "role": "memory"
    },
    {
      "id": "b",
      "label": "线程 B"
    }
  ],
  "state": [
    {
      "id": "x",
      "label": "x",
      "value": "false"
    },
    {
      "id": "y",
      "label": "y",
      "value": "false"
    }
  ],
  "steps": [
    {
      "from": "a",
      "to": "nx",
      "text": "追加 true",
      "set": {
        "x": "true"
      },
      "note": "A 把 x 的 true 追加到 x 的记事本"
    },
    {
      "from": "b",
      "to": "ny",
      "text": "追加 true",
      "set": {
        "y": "true"
