      "note": "B 把 y 的 true 追加到 y 的记事本"
    },
    {
      "at": "a",
      "text": "写 x=true；读 y=false",
      "tone": "bad",
      "note": "A 先写 x，再读 y，看到 B 的写还没来"
    },
    {
      "at": "b",
      "text": "写 y=true；读 x=false",
      "tone": "bad",
      "note": "B 先写 y，再读 x，看到 A 的写还没来"
    },
    {
      "span": [
        "nx",
        "ny"
      ],
      "text": "各自单调，合起来无序",
      "tone": "bad",
      "note": "两本记事本拼不出一条全局时间线"
