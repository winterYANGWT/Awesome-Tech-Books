{
  "kind": "seq",
  "title": "并行计时协议：对齐、取最大、取最短",
  "alt": "四个线程在 latch 对齐后各自计时，主线程取最大值，重复五次取最短",
  "lanes": [
    {
      "id": "main",
      "label": "主线程"
    },
    {
      "id": "t0",
      "label": "线程 0"
    },
    {
      "id": "t1",
      "label": "线程 1"
    },
    {
      "id": "t2",
      "label": "线程 2"
    },
    {
      "id": "t3",
      "label": "线程 3"
    }
