  "state": [
    {
      "id": "run",
      "label": "第几次",
      "value": "1"
    },
    {
      "id": "max",
      "label": "本次最长",
      "value": "—"
    },
    {
      "id": "best",
      "label": "五次最短",
      "value": "—"
    }
  ],
  "steps": [
    {
      "span": [
        "main",
        "t0",
        "t1",
        "t2",
        "t3"
      ],
      "text": "`latch` 对齐",
      "note": "四个工作线程和主线程都调用 arrive_and_wait"
    },
    {
      "span": [
        "main",
        "t0",
        "t1",
        "t2",
        "t3"
      ],
      "text": "最后到达者释放",
      "note": "最后一个到达的参与者释放 latch；主线程不一定是它"
    },
    {
      "ops": [
        {
          "at": "t0",
          "text": "先完成"
        },
        {
          "at": "t1",
          "text": "先完成"
        },
        {
          "at": "t2",
          "text": "先完成"
        },
        {
          "at": "t3",
          "text": "工作最多",
          "tone": "wait"
        }
      ],
      "note": "线程 3 分到的工作最多，结束得最晚"
    },
    {
      "ops": [
        {
          "at": "t0",
          "text": "记结束"
        },
        {
          "at": "t1",
          "text": "记结束"
        },
        {
          "at": "t2",
          "text": "记结束"
        },
        {
          "at": "t3",
          "text": "记结束"
        }
      ],
      "lane": {
        "t0": "done",
        "t1": "done",
        "t2": "done",
        "t3": "done"
      },
      "note": "每个线程记自己的结束时间，不记别人的"
    },
    {
      "at": "main",
      "text": "只记自己的时间",
      "tone": "bad",
      "set": {
        "run": "1",
        "max": "主线程"
      },
      "note": "只取主线程时间会漏掉最慢的线程"
    },
    {
      "at": "main",
      "text": "`max(t0…t3)`",
      "set": {
        "max": "线程 3"
      },
      "note": "取全局最大值，才是这次运行真正的耗时"
    },
    {
      "at": "main",
      "text": "重复 5 次取最短",
      "set": {
        "run": "5",
        "best": "最短的 max"
      },
      "note": "重复 5 次取最短，避开偶发的调度和中断"
    },
    {
      "at": "main",
      "text": "报 best 与 p99",
      "note": "尾延迟用分布报告，不要用平均值掩盖长尾"
    }
  ]
}
