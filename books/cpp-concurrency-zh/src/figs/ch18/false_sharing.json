{
  "kind": "grid",
  "title": "伪共享：两个计数器挤在同一条缓存行",
  "alt": "两个线程各写一个计数器，却让整条缓存行在核间来回搬；分开后不再互扰",
  "rows": [
    {"label": "同一条行"},
    {"label": "分开以后"}
  ],
  "cols": 8,
  "legend": [
    {"key": "T0", "label": "核 0 / 线程 0"},
    {"key": "T1", "label": "核 1 / 线程 1"}
  ],
  "cells": [
    ["c0", "c1", null, null, null, null, null, null],
    [null, null, null, null, null, null, null, null]
  ],
  "brackets": [
    {"c": "0-7", "label": "每条行 64 字节"}
  ],
  "steps": [
    {"paint": [
      {"r": 0, "c": 0, "key": "T0"},
      {"r": 0, "c": 1, "key": "T1"}
    ], "mark": [{"r": 0, "c": "0-1"}],
     "note": "c0 和 c1 是两个变量，却落在同一条 64 字节行"},
    {"paint": [{"r": 0, "c": "0-7", "key": "T0"}],
     "note": "核 0 写 c0，整条行以独占状态留在核 0"},
    {"paint": [{"r": 0, "c": "0-7", "key": "T1"}],
     "note": "核 1 写 c1，先把整条行抢过来：行在核间来回搬"},
    {"paint": [{"r": 0, "c": "0-7", "key": "T0"}],
     "note": "核 0 再写又抢回；没共享变量，只共享了缓存行"},
    {"paint": [
      {"r": 0, "c": 1, "key": null, "text": ""},
      {"r": 1, "c": 0, "key": "T1", "text": "c1"}
    ], "mark": [{"r": 1, "c": 0}],
     "note": "把 c1 挪到另一条缓存行，c0 留在原行"},
    {"paint": [
      {"r": 0, "c": "0-7", "key": "T0"},
      {"r": 1, "c": "0-7", "key": "T1"}
    ], "note": "核 0 只碰行 0，核 1 只碰行 1：失效消失"}
  ]
}
