{
  "kind": "flow",
  "title": "Amdahl：串行段把上限钉在 1/r",
  "alt": "程序先走串行段再走并行段，核数再多也超不过 1/r",
  "grid": [4, 1],
  "nodes": [
    {"id": "serial", "label": "串行段 r", "at": [0, 0], "sub": "只有一个核在干"},
