{
  "kind": "grid",
  "title": "四种 schedule 把 16 次迭代分给 4 个线程",
  "alt": "static 是连续大块，static,2 按两块轮转，dynamic,2 谁空谁领，guided 的块从大到小",
  "cols": 16,
  "colLabels": "index",
  "rows": [
    {"label": "static"},
    {"label": "static,2"},
    {"label": "dynamic,2"},
    {"label": "guided"}
  ],
  "legend": [
    {"key": "T0", "label": "线程 0"},
    {"key": "T1", "label": "线程 1"},
    {"key": "T2", "label": "线程 2"},
    {"key": "T3", "label": "线程 3"}
  ],
  "steps": [
    {"paint": [
      {"r": 0, "c": "0-3", "key": "T0"},
      {"r": 0, "c": "4-7", "key": "T1"},
      {"r": 0, "c": "8-11", "key": "T2"},
      {"r": 0, "c": "12-15", "key": "T3"}
    ], "note": "static 无 chunk：每线程一大块，块大小未指定"},
    {"paint": [
      {"r": 1, "c": "0-1", "key": "T0"},
      {"r": 1, "c": "2-3", "key": "T1"},
      {"r": 1, "c": "4-5", "key": "T2"},
      {"r": 1, "c": "6-7", "key": "T3"}
    ], "note": "static,2：每轮各领 2 个，轮转分配"},
    {"paint": [
      {"r": 1, "c": "8-9", "key": "T0"},
      {"r": 1, "c": "10-11", "key": "T1"},
      {"r": 1, "c": "12-13", "key": "T2"},
      {"r": 1, "c": "14-15", "key": "T3"}
    ], "note": "第二轮继续轮转，线程 0 拿到 8–9"},
    {"paint": [
      {"r": 2, "c": "0-1", "key": "T0"},
      {"r": 2, "c": "2-3", "key": "T1"},
      {"r": 2, "c": "4-5", "key": "T2"},
      {"r": 2, "c": "6-7", "key": "T3"}
    ], "note": "dynamic,2：先各领一块，之后谁做完谁再领"},
    {"paint": [{"r": 2, "c": "8-9", "key": "T1"}], "mark": [{"r": 2, "c": "8-9"}], "note": "线程 1 先做完，领到下一块 8–9"},
    {"paint": [
      {"r": 2, "c": "10-11", "key": "T2"},
      {"r": 2, "c": "12-13", "key": "T0"},
      {"r": 2, "c": "14-15", "key": "T3"}
    ], "note": "其余线程按完成顺序领走剩下的块"},
    {"paint": [
      {"r": 3, "c": "0-5", "key": "T0"},
      {"r": 3, "c": "6-10", "key": "T1"}
    ], "note": "guided：先领大块，块大小约为剩余迭代数除以线程数"},
    {"paint": [
      {"r": 3, "c": "11-13", "key": "T2"},
      {"r": 3, "c": "14-15", "key": "T3"}
    ], "mark": [{"r": 3, "c": "11-15"}], "note": "后面的块越来越小，直到下限 chunk"}
  ]
}
