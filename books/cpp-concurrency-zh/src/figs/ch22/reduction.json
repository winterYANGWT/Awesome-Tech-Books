  "steps": [
    {
      "at": "shared",
      "text": "初始值 0",
      "note": "reduction 的私有副本按操作符初值初始化：加法是 0"
    },
    {
      "ops": [
        {
          "at": "t0",
          "text": "累加第 0 段"
        },
        {
          "at": "t1",
          "text": "累加第 1 段"
        },
        {
          "at": "t2",
          "text": "累加第 2 段"
        },
        {
          "at": "t3",
          "text": "累加第 3 段"
        }
      ],
      "set": {
        "p0": "a0",
        "p1": "a1",
        "p2": "a2",
        "p3": "a3"
      },
      "note": "每个线程只改自己的副本，不需要加锁"
    },
    {
      "at": "t0",
      "text": "副本 = a0",
      "set": {
        "p0": "a0"
      },
      "note": "线程 0 的局部和留在自己的副本里"
    },
    {
      "at": "t1",
      "text": "副本 = a1",
      "set": {
        "p1": "a1"
      },
      "note": "线程 1 的局部和也留在自己的副本里"
    },
    {
      "span": [
        "shared",
        "t0",
        "t1",
        "t2",
        "t3"
      ],
      "text": "块尾合并",
      "tone": "hot",
      "note": "区域结束时把副本和原值合并，合并位置和顺序都未指定"
    },
    {
      "from": "t0",
      "to": "shared",
      "text": "a0 + a1",
      "tone": "hot",
      "set": {
        "sum": "a0+a1",
        "p0": "—",
        "p1": "—"
      },
      "note": "示意：线程 0 和 1 的副本先合并"
    },
    {
      "from": "t2",
      "to": "shared",
      "text": "再加 a2",
      "tone": "hot",
      "set": {
        "sum": "a0+a1+a2",
        "p2": "—"
      },
      "note": "示意：也可以先合并 2 和 3，顺序不保证"
    },
    {
      "from": "t3",
      "to": "shared",
      "text": "再加 a3",
      "tone": "ok",
      "set": {
        "sum": "a0+a1+a2+a3",
        "p3": "—"
      },
      "note": "最后写回共享 sum；浮点加法因此可能和串行差末几位"
    }
  ]
}
