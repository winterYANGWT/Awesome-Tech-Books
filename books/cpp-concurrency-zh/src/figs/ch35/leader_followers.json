{
  "kind": "flow",
  "title": "领导者/追随者：先推选，再处理",
  "alt": "Leader 等到事件后先推选新 Leader，再自己处理；处理完回到 Follower 池",
  "grid": [
    3,
    3
  ],
  "nodes": [
    {
      "id": "events",
      "label": "事件源",
      "at": [
        0,
        1
      ],
      "shape": "store",
      "sub": "一个 epoll"
    },
    {
      "id": "leader",
      "label": "Leader",
      "at": [
        1,
        1
      ],
      "shape": "round",
      "sub": "epoll_wait"
    },
    {
      "id": "processing",
      "label": "Processing",
      "at": [
        2,
        1
      ],
      "shape": "round",
      "sub": "处理事件"
    },
    {
      "id": "followers",
      "label": "Follower 池",
      "at": [
        1,
        2
      ],
      "shape": "queue",
      "slots": 4,
      "sub": "睡在条件变量"
    }
  ],
  "edges": [
    {
      "id": "wait",
      "from": "events",
      "to": "leader",
      "label": "事件"
    },
    {
      "id": "promote",
      "from": "leader",
      "to": "followers",
      "label": "推选新 Leader",
      "dashed": true,
      "route": "hv",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "wake",
      "from": "followers",
      "to": "leader",
      "label": "接任",
      "dashed": true,
      "route": "vh",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "handle",
      "from": "leader",
      "to": "processing",
      "label": "自己处理"
    },
    {
      "id": "return",
      "from": "processing",
      "to": "followers",
      "label": "处理完回来",
      "dashed": true,
      "fromSide": "bottom",
      "toSide": "right"
    }
  ],
  "steps": [
    {
      "hi": [
        "events"
      ],
      "note": "所有线程共享同一个事件源"
    },
    {
      "token": [
        {
          "edge": "wait",
          "label": "就绪"
        }
      ],
      "note": "只有 Leader 调 epoll_wait"
    },
    {
      "token": [
        {
          "edge": "promote",
          "label": "推选"
        }
      ],
      "note": "先推选一个 Follower 当新 Leader"
    },
    {
      "token": [
        {
          "edge": "wake",
          "label": "唤醒"
        }
      ],
      "note": "新 Leader 醒来，接着等事件"
    },
    {
      "token": [
        {
          "edge": "handle",
          "label": "事件"
        }
      ],
      "note": "旧 Leader 自己处理刚拿到的事件"
    },
    {
      "hi": [
        "processing"
      ],
      "note": "处理期间新 Leader 已经在监听"
    },
    {
      "token": [
        {
          "edge": "return",
          "label": "回来"
        }
      ],
      "note": "处理完回到 Follower 池"
    },
    {
      "hi": [
        "leader"
      ],
      "note": "任意时刻只有一个 Leader；锁从队列移到推选"
    }
  ]
}
