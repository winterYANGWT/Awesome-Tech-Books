{
  "kind": "flow",
  "title": "线程池：提交、排队、固定 worker",
  "alt": "主线程把任务放进队列，固定数量的 worker 取走执行，结果回传",
  "grid": [4, 3],
  "nodes": [
    {"id": "main", "label": "主线程", "at": [0, 1], "shape": "round", "sub": "提交任务"},
    {"id": "queue", "label": "任务队列", "at": [1, 1], "shape": "queue", "slots": 4},
    {"id": "w1", "label": "worker 1", "at": [2, 0], "shape": "round"},
    {"id": "w2", "label": "worker 2", "at": [2, 1], "shape": "round"},
    {"id": "w3", "label": "worker 3", "at": [2, 2], "shape": "round"},
    {"id": "result", "label": "结果", "at": [3, 1], "shape": "store", "sub": "回传给调用方"}
  ],
  "edges": [
    {"id": "submit", "from": "main", "to": "queue", "label": "submit"},
    {"id": "take1", "from": "queue", "to": "w1", "label": "取任务"},
    {"id": "take2", "from": "queue", "to": "w2", "label": "取任务"},
    {"id": "take3", "from": "queue", "to": "w3", "label": "取任务"},
    {"id": "done1", "from": "w1", "to": "result", "label": "完成", "dashed": true},
    {"id": "done2", "from": "w2", "to": "result", "label": "完成", "dashed": true},
    {"id": "done3", "from": "w3", "to": "result", "label": "完成", "dashed": true}
  ],
  "steps": [
    {"hi": ["main", "queue"], "note": "主线程只负责提交，不亲自执行任务"},
    {"hi": ["w1", "w2", "w3"], "note": "worker 在启动时创建，数量不随连接数增长"},
    {"hi": ["result"], "note": "池负责执行，结果回传给调用方或 I/O 线程"}
  ],
  "static": true
}
