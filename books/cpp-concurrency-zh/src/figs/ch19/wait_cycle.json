      "label": "工作线程 0",
      "at": [
        2,
        1
      ],
      "shape": "round"
    },
    {
      "id": "w1",
      "label": "工作线程 1",
      "at": [
        2,
        0
      ],
      "shape": "round"
    },
    {
      "id": "w2",
      "label": "工作线程 2",
      "at": [
        2,
        2
      ],
      "shape": "round"
    },
    {
      "id": "w3",
      "label": "工作线程 3",
      "at": [
        2,
        3
      ],
      "shape": "round"
    }
