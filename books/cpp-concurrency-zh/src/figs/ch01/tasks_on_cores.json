{
  "kind": "seq",
  "title": "单核交替，双核并行",
  "alt": "单核靠时间片交替推进两个任务，双核才让两条指令流同时执行",
  "speed": 1500,
  "lanes": [
    {"id": "cpu0", "label": "CPU 0"},
    {"id": "cpu1", "label": "CPU 1"}
  ],
  "steps": [
    {"at": "cpu0", "text": "运行 A（时间片）", "note": "单核上 A 先跑一个时间片"},
    {"at": "cpu0", "text": "保存 A，切到 B", "tone": "wait", "note": "切换要保存寄存器、指令指针，还要换栈"},
    {"at": "cpu0", "text": "运行 B（时间片）", "note": "同一时刻只有一个任务在跑：这是并发"},
    {"at": "cpu0", "text": "切回 A", "note": "时间片用完再切回 A；切换本身是开销"},
    {"ops": [
      {"at": "cpu0", "text": "运行 A"},
      {"at": "cpu1", "text": "运行 B"}
    ], "lane": {"cpu1": "new"}, "note": "双核：A、B 各占一个核，同时推进"},
    {"ops": [
      {"at": "cpu0", "text": "A 继续"},
      {"at": "cpu1", "text": "B 继续"}
    ], "note": "两条指令流同一时刻执行，这才是并行"},
    {"span": ["cpu0", "cpu1"], "text": "同时结束", "tone": "ok", "note": "并行要求任务真的能同时推进，不只是交替"}
  ]
}
