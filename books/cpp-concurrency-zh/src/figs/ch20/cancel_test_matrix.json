{
  "kind": "grid",
  "title": "取消测试矩阵：五种时序，四列检查",
  "alt": "每种时序都要看停止标志、等待是否被唤醒、清理执行几次、队列还剩多少任务",
  "rows": [
    {
      "label": "请求早于启动"
    },
    {
      "label": "请求在等待中"
    },
    {
      "label": "请求晚于完成"
    },
    {
      "label": "重复请求"
    },
    {
      "label": "请求后立即析构"
    }
  ],
  "cols": 4,
  "colLabels": [
    "停止",
    "等待",
    "清理",
    "剩余"
  ],
  "legend": [
    {
      "key": "ok",
      "label": "预期通过"
    },
    {
      "key": "hot",
      "label": "重点检查"
    }
  ],
  "cells": [
    [
      "已请求",
      "未进入",
      "1",
      "0"
    ],
    [
      "等待中",
      "唤醒",
      "1",
      "0"
    ],
    [
      "完成后",
      "未涉及",
      "1",
      "0"
    ],
    [
      "二次否",
      "未涉及",
      "1",
      "0"
    ],
    [
      "析构前",
      "未涉及",
      "1",
      "0"
    ]
  ],
  "steps": [
    {
      "paint": [
        {
          "r": 0,
          "c": "0-3",
          "key": "ok"
        }
      ],
      "mark": [
        {
          "r": 0,
          "c": "2-2"
        }
      ],
      "note": "请求早于启动：线程第一次检查就看到停止，清理仍要执行一次"
    },
    {
      "paint": [
        {
          "r": 1,
          "c": "0-3",
          "key": "ok"
        }
      ],
      "mark": [
        {
          "r": 1,
          "c": "1-2"
        }
      ],
      "note": "请求在等待中：主线程等消费者进入 wait 后才发请求"
    },
    {
      "paint": [
        {
          "r": 2,
          "c": "0-3",
          "key": "ok"
        }
      ],
      "mark": [
        {
          "r": 2,
          "c": "0-0"
        }
      ],
      "note": "请求晚于完成：join 后再 request_stop 仍返回 true，但线程已结束"
    },
    {
      "paint": [
        {
          "r": 3,
          "c": "0-3",
          "key": "ok"
        }
      ],
      "mark": [
        {
          "r": 3,
          "c": "0-0"
        }
      ],
      "note": "重复请求：第二次返回 false，清理不能做第二次"
    },
    {
      "paint": [
        {
          "r": 4,
          "c": "0-3",
          "key": "ok"
        }
      ],
      "mark": [
        {
          "r": 4,
          "c": "2-2"
        }
      ],
      "note": "请求后立即析构：析构先 request_stop 再 join，清理不能省"
    }
  ],
  "static": true
}
