{
  "kind": "flow",
  "title": "三档停止方式：从随时杀死到协作停止",
  "alt": "异步取消最危险，延迟取消只在取消点生效，协作停止让线程自己清理后退出",
  "grid": [
    2,
    3
  ],
  "nodes": [
    {
      "id": "kill",
      "label": "随时杀死",
      "at": [
        0,
        0
      ],
      "sub": "异步取消 / 强制终止\nC++ 析构不保证，锁会留下"
    },
    {
      "id": "defer",
      "label": "延迟取消",
      "at": [
        0,
        1
      ],
      "sub": "pthread_cancel 默认\n只在取消点；析构仍不保证"
    },
    {
      "id": "coop",
      "label": "协作停止",
      "at": [
        0,
        2
      ],
      "sub": "标志、检查点、唤醒\n析构保证，锁由线程释放"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "kill",
      "to": "defer",
      "label": "更温和"
    },
    {
      "id": "e2",
      "from": "defer",
      "to": "coop",
      "label": "协议化"
    }
  ],
  "static": true,
  "steps": [
    {
      "hi": [
        "kill"
      ],
      "tone": {
        "kill": "bad"
      },
      "note": "随时杀死：在任意指令处中断，半更新的数据结构和锁都可能留下"
    },
    {
      "hi": [
        "defer"
      ],
      "tone": {
        "defer": "wait"
      },
      "note": "延迟取消：请求排队，线程走到取消点才响应；资源要靠清理函数"
    },
    {
      "hi": [
        "coop"
      ],
      "tone": {
        "coop": "ok"
      },
      "note": "协作停止：发起方请求，目标方在检查点或等待返回后自己退出"
    }
  ]
}
