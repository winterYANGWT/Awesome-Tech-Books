{
  "kind": "seq",
  "title": "gdb 看多线程：先全停，再只放一个线程",
  "alt": "gdb 暂停所有线程，切到线程 2，打开 scheduler-locking 后只有它动，最后取所有栈",
  "lanes": [
    {"id": "gdb", "label": "gdb", "role": "process"},
    {"id": "t1", "label": "线程 1"},
    {"id": "t2", "label": "线程 2"},
    {"id": "t3", "label": "线程 3"}
  ],
  "state": [
    {"id": "current", "label": "当前线程", "value": "—"}
  ],
  "steps": [
    {"span": ["gdb", "t1", "t2", "t3"], "text": "程序暂停", "lane": {"t1": "blocked", "t2": "blocked", "t3": "blocked"}, "note": "断点或 Ctrl-C 让所有线程停下"},
    {"at": "gdb", "text": "`info threads`", "note": "列出线程 1、2、3 和当前函数"},
    {"at": "gdb", "text": "`thread 2`", "tone": "hot", "set": {"current": "2"}, "note": "切到线程 2；其他线程仍停着"},
    {"at": "gdb", "text": "`scheduler-locking on`", "tone": "hot", "lane": {"t2": "running"}, "note": "第 4 步：只有线程 2 能跑，单步不会被打断"},
    {"at": "t2", "text": "`next` / `step`", "tone": "hot", "note": "线程 2 单步；线程 1、3 保持不动"},
    {"at": "gdb", "text": "`thread apply all bt`", "lane": {"t2": "blocked"}, "note": "一次取回三个线程的栈，对照锁和等待"}
  ]
}
