{
  "kind": "seq",
  "title": "notify_one 之后：A 抛异常，B 永远等",
  "alt": "A 取走唯一元素后构造返回值抛异常；B 已在等待，通知已消耗，没人再唤醒它",
  "lanes": [
    {
      "id": "a",
      "label": "消费者 A"
    },
    {
      "id": "b",
      "label": "消费者 B"
    },
    {
      "id": "q",
      "label": "队列",
      "role": "memory"
    },
    {
      "id": "p",
      "label": "生产者"
    }
  ],
  "state": [
    {
      "id": "items",
      "label": "队列元素",
      "value": "0"
    },
    {
      "id": "waiters",
      "label": "等待者",
      "value": "—"
    }
  ],
  "steps": [
    {
      "at": "a",
      "text": "`wait`",
      "lane": {
        "a": "blocked",
        "b": "sleeping"
      },
      "set": {
        "waiters": "A"
      },
      "note": "A 先睡在 wait 上"
    },
    {
      "from": "p",
      "to": "q",
      "text": "`push(1)`",
      "set": {
        "items": "1"
      },
      "note": "生产者放入唯一的元素"
    },
    {
      "from": "p",
      "to": "a",
      "text": "`notify_one()`",
      "dashed": true,
      "tone": "hot",
      "lane": {
        "a": "running"
      },
      "note": "只唤醒 A：一个元素够一个消费者"
    },
    {
      "from": "q",
      "to": "a",
      "text": "A 取走元素",
      "set": {
        "items": "0"
      },
      "note": "A 醒来、重锁、把元素移出队列"
    },
    {
      "at": "b",
      "text": "`wait`",
      "lane": {
        "b": "blocked"
      },
      "set": {
        "waiters": "B"
      },
      "note": "B 这时才进入等待，A 已经解锁"
    },
    {
      "at": "a",
      "text": "构造返回值抛异常",
      "tone": "bad",
      "lane": {
        "a": "done"
      },
      "note": "元素已经不在队列里，A 退出"
    },
    {
      "at": "p",
      "text": "生产者结束",
      "tone": "bad",
      "note": "通知已经消耗，没人再叫醒 B"
    }
  ]
}
