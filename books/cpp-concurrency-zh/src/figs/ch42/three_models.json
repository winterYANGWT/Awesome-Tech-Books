{
  "kind": "flow",
  "title": "三种 I/O 复用每次事件的工作量",
  "alt": "select/poll 每次复制并扫描全部集合，epoll 只把本次就绪项拷给用户",
  "grid": [4, 3],
  "bands": [
    {"label": "select", "rows": [0, 0]},
    {"label": "poll", "rows": [1, 1]},
    {"label": "epoll", "rows": [2, 2]}
  ],
  "nodes": [
    {"id": "app", "label": "应用", "at": [0, 1], "shape": "round"},
    {"id": "sel", "label": "复制并扫描\nfd_set", "at": [1, 0], "sub": "每次调用 O(1024)"},
    {"id": "poll", "label": "复制并扫描\npollfd[]", "at": [1, 1], "sub": "每次调用 O(n)"},
    {"id": "ctl", "label": "epoll_ctl", "at": [1, 2], "sub": "注册一次"},
    {"id": "ready", "label": "就绪表", "at": [2, 2], "shape": "queue", "slots": 3},
    {"id": "wait", "label": "epoll_wait", "at": [3, 2], "sub": "只拷贝就绪项"}
  ],
  "edges": [
    {"id": "e1", "from": "app", "to": "sel", "label": "每次"},
    {"id": "e2", "from": "app", "to": "poll", "label": "每次"},
    {"id": "e3", "from": "app", "to": "ctl", "label": "一次"},
    {"id": "e4", "from": "ctl", "to": "ready", "label": "事件到达"},
    {"id": "e5", "from": "ready", "to": "wait", "label": "取走"}
  ],
  "steps": [
    {"hi": ["app"], "note": "三个模型都从一个应用要等很多 fd 开始"},
    {"token": [{"edge": "e1", "label": "fd_set"}], "hi": ["sel"], "note": "select 每次都要重建并复制 1024 位的集合"},
    {"token": [{"edge": "e2", "label": "pollfd[]"}], "hi": ["poll"], "note": "poll 不必重建，但仍要复制整个数组并线性扫描"},
    {"token": [{"edge": "e3", "label": "EPOLLIN"}], "hi": ["ctl"], "note": "epoll 用 epoll_ctl 把兴趣注册一次，内核长期保存"},
    {"token": [{"edge": "e4", "label": "数据"}], "hi": ["ready"], "note": "事件到达后挂进就绪表，不扫描全部注册项"},
    {"token": [{"edge": "e5", "label": "就绪事件"}], "hi": ["wait"], "note": "epoll_wait 只拷贝本次就绪的事件，成本随就绪数增长"}
  ]
}
