  "static": true,
  "steps": [
    {
      "hi": [
        "aio",
        "helper"
      ],
      "note": "aio_read 在 glibc 里交给用户态辅助线程，不是内核异步"
    },
    {
      "hi": [
        "submit",
        "fileop"
      ],
      "note": "内核 AIO 的 opcode 有文件读写、fsync、poll，没有 accept/recv"
    },
    {
      "hi": [
        "sqe",
        "kernel"
      ],
      "note": "io_uring 把请求写进 SQ，由内核执行"
    },
    {
      "hi": [
        "cqe",
        "app"
      ],
      "note": "完成写进 CQ，应用读 res：完成式，不是就绪式"
    }
